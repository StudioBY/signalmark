{
  "name": "Analysis",
  "type": "object",
  "properties": {
    "engine_version": {
      "type": "string"
    },
    "profile_url": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "posts_count": {
      "type": "number"
    },
    "headline": {
      "type": "string"
    },
    "about": {
      "type": "string"
    },
    "posts": {
      "type": "string"
    },
    "corpus_url": {
      "type": "string",
      "description": "URL of the corpus JSON file, used when the corpus is too large to store inline"
    },
    "overall_score": {
      "type": "number"
    },
    "verdict_title": {
      "type": "string"
    },
    "verdict_summary": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "weight": {
            "type": "number"
          },
          "method": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          }
        }
      }
    },
    "signal_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "lexical_stats": {
      "type": "object",
      "properties": {
        "word_count": {
          "type": "number"
        },
        "type_token_ratio": {
          "type": "number"
        },
        "avg_sentence_length": {
          "type": "number"
        },
        "evidence_marker_count": {
          "type": "number"
        },
        "evidence_per_100_words": {
          "type": "number"
        },
        "trigram_repeat_rate": {
          "type": "number"
        },
        "boilerplate_per_100_words": {
          "type": "number"
        },
        "filler_per_100_words": {
          "type": "number"
        },
        "repeated_phrases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boilerplate_hits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "top_content_words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dominant_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rewrites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "original": {
            "type": "string"
          },
          "revised": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "email": {
      "type": "string"
    },
    "unlocked": {
      "type": "boolean",
      "default": false
    },
    "is_sample": {
      "type": "boolean",
      "default": false,
      "description": "When true, this stored report is served publicly in the SAMPLE REPORTS section"
    },
    "sample_name": {
      "type": "string",
      "description": "Display name for the sample card and report header, overrides full_name"
    }
  },
  "required": []
}