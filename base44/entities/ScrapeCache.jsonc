{
  "name": "ScrapeCache",
  "type": "object",
  "properties": {
    "profile_url": {
      "type": "string",
      "description": "Normalized LinkedIn profile URL used as the cache key"
    },
    "scraped_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "string",
      "description": "JSON-serialized trimmed corpus, stored inline when small enough"
    },
    "payload_url": {
      "type": "string",
      "description": "URL of the corpus JSON file, used when the corpus is too large to store inline"
    },
    "hits": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "profile_url"
  ]
}