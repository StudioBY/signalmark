{
  "name": "Purchase",
  "type": "object",
  "properties": {
    "profile_url": {
      "type": "string",
      "description": "Normalized LinkedIn profile URL the report was purchased for"
    },
    "email": {
      "type": "string",
      "description": "Email collected before checkout, receives the PDF"
    },
    "ip": {
      "type": "string",
      "description": "Client IP, used for the daily abuse guard"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "delivered",
        "refunded"
      ],
      "default": "pending"
    },
    "analysis_id": {
      "type": "string"
    },
    "amount_cents": {
      "type": "number",
      "default": 100
    },
    "pdf_sent": {
      "type": "boolean",
      "default": false,
      "description": "True once the report PDF has been emailed, keeps delivery idempotent"
    }
  },
  "required": [
    "profile_url",
    "email"
  ]
}